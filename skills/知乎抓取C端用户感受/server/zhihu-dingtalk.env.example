# Copy to /home/jolin/.config/zhihu-dingtalk.env with mode 600.
# Resolve the profile from `dws profile list`; never commit the real Webhook token.
DINGTALK_PROFILE=corpId:userId
DINGTALK_GROUP_NAME=海外信息同步
DINGTALK_GROUP_ID=openConversationId
DINGTALK_WEBHOOK_TOKEN=replace-with-private-token
N8N_DINGTALK_WEBHOOK_URL=http://127.0.0.1:5678/webhook/zhihu-market-intelligence
